# Copy to repo root as `.env` before `docker compose up -d`
APP_DOMAIN=app.kibookal.tech
ACME_EMAIL=you@kibookal.tech
JWT_SECRET=change-me-to-a-long-random-string

# PostgreSQL (persistent user/workspace data)
POSTGRES_DB=whatsapp
POSTGRES_USER=whatsapp
POSTGRES_PASSWORD=change-me-strong-db-password

# First admin account (created on first API startup if no users exist)
ADMIN_EMAIL=admin@kibookal.tech
ADMIN_PASSWORD=change-me-strong-password
ADMIN_USERNAME=admin

# Super admin (Database section + snapshots). Comma-separated emails.
SUPER_ADMIN_EMAILS=harsh.jaiswal@anibrain.com

# Backups land here on the host (outside Docker volumes). Hourly DB dumps +
# append-only media mirror. See DEPLOY.md "Data safety".
BACKUP_HOST_DIR=/var/backups/kib_whatsapp
WA_BACKUP_INTERVAL_SECONDS=3600
# Optional: alert webhook for backup failures. Leave blank to disable.
WA_BACKUP_ALERT_WEBHOOK=
WA_BACKUP_ALERT_MIN_FAILURES=1

# AI via OpenRouter (recommended)
OPENROUTER_API_KEY=sk-or-v1-your-key-here
OPENROUTER_MODEL=google/gemma-4-31b-it:free
OPENROUTER_APP_NAME=WhatsApp Strategy Canvas
OPENROUTER_HTTP_REFERER=https://app.kibookal.tech
